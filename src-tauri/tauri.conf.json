{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/v1/schema.json",
  "package": {
    "productName": "Clarifile",
    "version": "0.1.0"
  },
  "tauri": {
    "bundle": {
      "identifier": "com.clarifile.app"
    },
    "allowlist": {
      "all": true
    },
    "windows": [
      {
        "title": "Clarifile",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ]
  },
  "build": {
    "beforeDevCommand": "vite dev",
    "beforeBuildCommand": "vite build",
    "devPath": "http://localhost:5173",
    "distDir": "../dist"
  }
}
